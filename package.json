{
  "name": "@flologixai/marv",
  "version": "0.3.0",
  "description": "A terminal coding agent",
  "private": true,
  "license": "MIT",
  "author": "FlologixAI",
  "homepage": "https://github.com/FlologixAI/marv#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FlologixAI/marv.git"
  },
  "bugs": {
    "url": "https://github.com/FlologixAI/marv/issues"
  },
  "keywords": [
    "ai",
    "agent",
    "coding-agent",
    "cli",
    "terminal",
    "llm",
    "openrouter",
    "ollama",
    "mcp",
    "bun"
  ],
  "type": "module",
  "exports": {
    "./sdk": "./src/sdk.ts",
    "./package.json": "./package.json"
  },
  "engines": {
    "bun": ">=1.3"
  },
  "bin": {
    "marv": "./bin/marv"
  },
  "scripts": {
    "dev": "bun src/cli.tsx",
    "test": "bun test",
    "stats": "bun scripts/trajectory-stats.ts",
    "typecheck": "tsc --noEmit",
    "eval": "bun evals/run.ts",
    "release:build": "bun scripts/release.ts",
    "review": "bun scripts/review-gate.ts",
    "prepare": "test -n \"$CI\" || test -n \"$(git config core.hooksPath)\" || git config core.hooksPath .githooks"
  },
  "dependencies": {
    "@babel/parser": "^7.29.9",
    "@modelcontextprotocol/sdk": "^1.32.0",
    "@mozilla/readability": "^0.6.0",
    "diff": "^9.0.0",
    "ink": "^8.0.0",
    "ink-spinner": "^5.0.0",
    "ink-text-input": "^6.0.0",
    "linkedom": "^0.18.13",
    "marked": "^18.0.14",
    "react": "^19.3.0",
    "slice-ansi": "^9.0.1",
    "string-width": "^8.3.0",
    "strip-ansi": "^7.2.0",
    "turndown": "^7.2.4",
    "turndown-plugin-gfm": "^1.0.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "@types/react": "^19.3.0",
    "@types/turndown": "^5.0.6",
    "ink-testing-library": "^4.0.0",
    "typescript": "^7.0.2"
  },
  "patchedDependencies": {
    "ink@8.0.0": "patches/ink@8.0.0.patch",
    "string-width@8.3.0": "patches/string-width@8.3.0.patch",
    "ink-text-input@6.0.0": "patches/ink-text-input@6.0.0.patch"
  }
}

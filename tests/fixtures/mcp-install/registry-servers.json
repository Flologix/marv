{
  "io.modelcontextprotocol/filesystem": {
    "server": {
      "name": "io.modelcontextprotocol/filesystem",
      "description": "Secure file operations with configurable access controls.",
      "repository": { "url": "https://github.com/modelcontextprotocol/servers", "source": "github" },
      "version": "2025.8.21",
      "packages": [
        {
          "registryType": "npm",
          "registryBaseUrl": "https://registry.npmjs.org",
          "identifier": "@modelcontextprotocol/server-filesystem",
          "version": "2025.8.21",
          "runtimeHint": "npx",
          "transport": { "type": "stdio" },
          "runtimeArguments": [{ "type": "positional", "value": "-y" }],
          "packageArguments": [
            { "type": "positional", "value": "--stdio" },
            { "type": "named", "name": "--mode", "default": "safe" },
            { "type": "positional", "valueHint": "root_dir", "description": "The folder it may read", "isRequired": true },
            { "type": "positional", "valueHint": "extra", "description": "Optional second folder" }
          ],
          "environmentVariables": [
            { "name": "FS_TOKEN", "description": "A token", "isRequired": true, "isSecret": true },
            { "name": "FS_LEVEL", "isRequired": true, "default": "info" },
            { "name": "FS_DEBUG", "description": "Optional debugging" }
          ]
        },
        { "registryType": "pypi", "identifier": "mcp-server-filesystem", "version": "1.0.0", "transport": { "type": "stdio" } }
      ]
    },
    "_meta": { "io.modelcontextprotocol.registry/official": { "status": "active", "isLatest": true } }
  },
  "io.github.acme/fetch": {
    "server": {
      "name": "io.github.acme/fetch",
      "version": "2025.4.7",
      "packages": [
        { "registryType": "oci", "identifier": "ghcr.io/acme/fetch:1", "transport": { "type": "stdio" } },
        { "registryType": "pypi", "registryBaseUrl": "https://pypi.org", "identifier": "mcp-server-fetch", "version": "2025.4.7", "runtimeHint": "uvx", "transport": { "type": "stdio" } }
      ]
    },
    "_meta": { "io.modelcontextprotocol.registry/official": { "status": "active", "isLatest": true } }
  },
  "ai.smithery/github": {
    "server": {
      "name": "ai.smithery/github",
      "version": "1.0.0",
      "remotes": [
        { "type": "sse", "url": "https://server.smithery.ai/github/sse" },
        {
          "type": "streamable-http",
          "url": "https://server.smithery.ai/github/mcp",
          "headers": [
            { "name": "Authorization", "description": "Bearer token", "isRequired": true, "isSecret": true, "value": "Bearer {smithery_api_key}" },
            { "name": "X-Api-Key", "isRequired": true, "isSecret": true },
            { "name": "X-Optional", "description": "not needed" }
          ]
        }
      ]
    },
    "_meta": { "io.modelcontextprotocol.registry/official": { "status": "active", "isLatest": true } }
  },
  "io.github.acme/docker-only": {
    "server": {
      "name": "io.github.acme/docker-only",
      "version": "1.0.0",
      "packages": [{ "registryType": "oci", "identifier": "ghcr.io/acme/docker-only:1.0.0", "transport": { "type": "stdio" } }]
    },
    "_meta": { "io.modelcontextprotocol.registry/official": { "status": "active", "isLatest": true } }
  },
  "com.example/deprecated": {
    "server": { "name": "com.example/deprecated", "version": "1.0.0", "remotes": [{ "type": "streamable-http", "url": "https://example.com/mcp" }] },
    "_meta": { "io.modelcontextprotocol.registry/official": { "status": "deprecated", "isLatest": true } }
  }
}

{
  "routes": [
    { "path": "/", "handler": "home", "methods": ["GET"] },
    { "path": "/login", "handler": "login", "methods": ["GET", "POST"] },
    { "path": "/users/:id", "handler": "user", "methods": ["GET", "DELETE"] },
    { "path": "/users/:id/posts", "handler": "userPosts", "methods": ["GET"] }
  ]
}

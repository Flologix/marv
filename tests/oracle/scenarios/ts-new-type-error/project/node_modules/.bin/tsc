#!/bin/sh
# A stand-in for tsc: the oracle's projects have no TypeScript. It reports the one error this scenario can make, as
# `tsc --noEmit --pretty false` would.
if grep -q formatPrice src/cart.ts && ! grep -q "export function formatPrice" src/format.ts; then
  cat <<'OUT'
src/cart.ts(1,10): error TS2305: Module '"./format.ts"' has no exported member 'formatPrice'.
OUT
  exit 2
fi
exit 0
